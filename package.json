{
  "name": "teamsync",
  "version": "2.5.1",
  "main": "dist-electron/electron/main.js",
  "description": "TeamSync is a meeting notes app that uses AI to generate notes from your meetings.",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && tsc && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:tsc": "tsc -p electron/tsconfig.json",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "postinstall": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm rebuild sharp && node scripts/download-models.js && node scripts/ensure-sqlite-vec.js && node scripts/patch-electron-plist.js",
    "electron:dev": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build:electron && cross-env NODE_ENV=production electron .",
    "app:dev": "concurrently \"npm run dev -- --port 5180 --strictPort\" \"wait-on http://localhost:5180 && npm run electron:dev\"",
    "app:build": "npm run build && npm run build:electron && npm run build:backend && cross-env TEAMSYNC_BUILD_ALL_MAC_ARCHES=1 npm run build:native && electron-builder",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build",
    "build:native": "node scripts/build-native.js",
    "build:backend": "cd backend && npm run build"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.electron.meeting-notes",
    "productName": "TeamSync",
    "afterPack": "./scripts/ad-hoc-sign.js",
    "compression": "normal",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/*.dylib",
      "native-module/**"
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "native-module/**",
      "package.json",
      "node_modules/**",
      "!**/native-module/target/**",
      "!**/native-module/src/**",
      "!**/native-module/.cargo/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!**/*.map"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "resources/models/",
        "to": "models/"
      },
      {
        "from": "native-module/",
        "to": "native-module/"
      },
      {
        "from": "python-runtime/ocr/",
        "to": "python/ocr/"
      },
      {
        "from": "python-runtime/models/",
        "to": "python/ocr/models/"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "extraResources": [
        {
          "from": "python-runtime/mac-${arch}/",
          "to": "python/"
        }
      ],
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "TeamSync needs Screen Recording permission to analyze screens and provide interview assistance.",
        "NSMicrophoneUsageDescription": "TeamSync needs microphone access for live transcription and interview assistance."
      }
    },
    "dmg": {
      "size": "4g"
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "python-runtime/windows-x64/",
          "to": "python/"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icons/png/",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tarunshetty125",
        "repo": "TeamSync",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@napi-rs/cli": "^3.5.1",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/color": "^4.2.0",
    "@types/dagre": "^0.7.53",
    "@types/diff": "^6.0.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-bedrock": "^3.1057.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1057.0",
    "@aws-sdk/credential-providers": "^3.1057.0",
    "@bany/curl-to-json": "^1.2.10",
    "@deepgram/sdk": "^3.13.0",
    "@elevenlabs/client": "^0.15.1",
    "@elevenlabs/elevenlabs-js": "^2.39.0",
    "@google-cloud/speech": "^7.2.1",
    "@google/genai": "^1.44.0",
    "@google/stitch-sdk": "^0.0.3",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@tavily/core": "^0.7.2",
    "@types/keytar": "^4.4.0",
    "@types/three": "^0.182.0",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.7.7",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "diff": "^7.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "elkjs": "^0.11.1",
    "form-data": "^4.0.1",
    "framer-motion": "^12.29.2",
    "groq-sdk": "^0.37.0",
    "jspdf": "^4.0.0",
    "katex": "^0.16.27",
    "keytar": "^7.9.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "mermaid": "^11.15.0",
    "openai": "^6.22.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5",
    "sqlite-vec": "^0.1.7-alpha.2",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.5.4",
    "tap": "^21.5.0",
    "tesseract.js": "^5.0.5",
    "three": "^0.182.0",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.3",
    "ws": "^8.19.0",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "^0.1.7-alpha.2",
    "sqlite-vec-darwin-x64": "^0.1.7-alpha.2"
  }
}
